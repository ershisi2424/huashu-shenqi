# 服务端配置示例说明：复制为部署目录的 .env.local 后再填写真实值。
# 本文件只描述 API、认证和本地运行参数；Runtime 安全边界由 lib/ 下的服务端
# 代码和 vendor/goutoujunshi 参考快照决定，不要把安全规则或密钥提交到仓库。
ZAI_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-5.3
# 智谱 OpenAI 兼容端点
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 本地开发限流：默认 10 分钟最多 60 次，可按需调整
# PROFILE_RATE_LIMIT_MAX=60
# PROFILE_RATE_LIMIT_WINDOW_MS=600000
# OCR 语言包，首次实际识别时由 tesseract.js 按需加载
# OCR_LANG=chi_sim+eng
# 第三阶段账号权限：生产环境未显式配置时默认要求登录；开发预览可显式关闭
# AUTH_REQUIRED=true
# AUTH_DB_PATH=./data/auth.sqlite
# AUTH_SESSION_TTL_MS=28800000
# AUTH_COOKIE_SECURE=false  # HTTPS 部署时改为 true
# 登录入口限流默认：15 分钟同一来源或账号最多 10 次
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# 注册和游客登录默认：1 小时同一来源或账号最多 5 次
# AUTH_REGISTER_RATE_LIMIT_MAX=5
# AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# AUTH_GUEST_RATE_LIMIT_MAX=5
# AUTH_GUEST_RATE_LIMIT_WINDOW_MS=3600000
# 密码恢复消费入口：15 分钟最多 20 次；仅管理员签发的一次性令牌可消费
# AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=20
# AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
# 仅在反向代理已可信配置时开启，否则客户端可伪造 X-Forwarded-For
# TRUST_PROXY=false
# 首次部署可通过服务端脚本调用 ensureBootstrapAdmin 创建最高权限账号，密码不会写入配置文件
