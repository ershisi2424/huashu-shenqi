<service>
  <id>HuashuWorkbench</id>
  <name>Huashu Workbench</name>
  <description>Huashu local LAN workbench service</description>
  <executable>%BASE%\runtime\node.exe</executable>
  <arguments>%BASE%\scripts\windows\huashu-launcher.cjs</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 day</resetfailure>
  <log mode="roll-by-size-time" sizeThreshold="10485760" />
  <serviceaccount>
    <username>LocalService</username>
  </serviceaccount>
</service>
